# Copiar a .env.local y completar desde Connect del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Usar publishable (sb_publishable_...), nunca secret ni service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor: necesaria para registrar usuarios desde Administración.
# Copiar la Secret key de Supabase. Nunca usar el prefijo NEXT_PUBLIC para ella.
SUPABASE_SECRET_KEY=
